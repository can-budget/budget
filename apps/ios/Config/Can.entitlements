<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>com.apple.security.application-groups</key><array><string>$(CAN_APP_GROUP)</string></array>
<key>keychain-access-groups</key><array><string>$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string><string>$(AppIdentifierPrefix)$(CAN_KEYCHAIN_GROUP)</string></array>
<key>aps-environment</key><string>$(CAN_APNS_ENTITLEMENT_ENVIRONMENT)</string>
</dict></plist>
